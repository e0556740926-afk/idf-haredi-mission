# mock (default) or supabase — see src/data/index.ts
VITE_DATA_SOURCE=mock

# Only needed when VITE_DATA_SOURCE=supabase. Run `npx supabase start` and
# copy its printed "API URL" and "anon key" here (into .env.local, not this
# file).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
